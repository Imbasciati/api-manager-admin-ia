DATABASE_URL="postgresql://user:password@localhost:5432/agentflow"
JWT_SECRET=sua_chave_secreta_muito_forte_aqui
JWT_REFRESH_SECRET=outra_chave_secreta_para_refresh
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Supabase — Banco de conversas (módulo Atendimentos)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_KEY=sua_service_role_key

# ── Meta / WhatsApp Business API (WABA) ──────────────────────────────────────
# Obtenha em: developers.facebook.com → seu App → Configurações → Básico
META_APP_ID=
META_APP_SECRET=

# Token que você define livremente — registre o mesmo no painel da Meta
# (Configurações do App → WhatsApp → Configuração → Webhook → Verify Token)
META_WEBHOOK_VERIFY_TOKEN=

# URI de redirecionamento registrada no seu App da Meta (pode ser qualquer URL válida
# cadastrada em Login do Facebook → OAuth → URIs de redirecionamento válidos)
META_REDIRECT_URI=

# ID da configuração do Embedded Signup — gerado em:
# App da Meta → WhatsApp → Embedded Signup → Criar configuração
META_CONFIG_ID=
